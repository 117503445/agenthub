# 如需使用允许列表模板，可参考社区模板：
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# 程序和插件二进制文件
*.exe
*.exe~
*.dll
*.so
*.dylib

# `go test -c` 生成的测试二进制
*.test

# 覆盖率和测试产物
*.out
coverage.*
*.coverprofile
profile.cov

# 依赖目录
# vendor/

# Go 工作区文件
go.work
go.work.sum

# 环境变量文件
.env

# Node 和前端依赖
node_modules/
fe/node_modules/
fe/dist/
cmd/web/dist/assets/
cmd/web/dist/agenthub-icon.svg
cmd/web/dist/manifest.webmanifest
cmd/web/dist/sw.js

# Python 环境
.venv/
scripts/e2e/.venv/

# 项目输出
data/
.task/
*.pyc
__pycache__/

# 编辑器配置
# .idea/
# .vscode/
